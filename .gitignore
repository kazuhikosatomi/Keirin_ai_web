# ============================================================
# Default: ignore everything
# Git is used primarily for files that need to be published.
# ============================================================
*

# ============================================================
# Repository essentials
# ============================================================
!.gitignore
!README.md
!requirements.txt

# ============================================================
# Public website root
# ============================================================
!docs/

# Main public pages
!docs/index.html
!docs/index_grade05.html
!docs/index_seven01.html
!docs/archive.html
!docs/notice.txt

# ============================================================
# grade05 - current production site
# ============================================================
!docs/grade05/
!docs/grade05/**

# Local-only grade05 files
docs/grade05/latest/snapshot/
docs/grade05/templates/
docs/grade05/today_template.html

# ============================================================
# seven01 - occasional public test site
# ============================================================
!docs/seven01/
!docs/seven01/**

# ============================================================
# Full-race prediction PDFs - public
# ============================================================
!docs/predict/
!docs/predict/pdf/
!docs/predict/pdf/gr01/
!docs/predict/pdf/gr01/**

# Prediction CSV - local processing only
docs/predict/csv/

# ============================================================
# Full-race result PDFs - public
# ============================================================
!docs/results/
!docs/results/pdf/
!docs/results/pdf/gr01/
!docs/results/pdf/gr01/**

# Result CSV - local processing only
docs/results/csv/

# ============================================================
# public01 - local test site for now
# Will be enabled for Git when production migration is complete.
# ============================================================
docs/public/

# ============================================================
# Local / temporary files
# ============================================================
.DS_Store
**/.DS_Store
.env
.env.*
config/line.env

# Old public9 migration test files
scripts/public9_preview/
data/public9_preview/
tmp/public9_audit/
